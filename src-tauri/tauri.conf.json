{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selyh",
  "version": "0.1.0",
  "identifier": "app.selyh.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "appimage",
      "deb"
    ],
    "category": "HealthcareAndFitness",
    "shortDescription": "Check-ins de un toque sin salir de tu trabajo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Selyh",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "languages": [
          "Spanish"
        ]
      },
      "wix": {
        "bannerPath": "installer/msi-banner.bmp",
        "dialogImagePath": "installer/msi-dialog.bmp",
        "language": "es-ES"
      }
    }
  }
}
